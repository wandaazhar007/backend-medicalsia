# Server
PORT=5017
NODE_ENV=development

# Supabase / PostgreSQL — one isolated database per clinic deployment
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Firebase Admin SDK (verifies the Firebase ID token sent by the frontend)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Encryption key for whatsapp_settings.device_token and email_settings.email_password
# Must be a strong random value (e.g. 32-byte base64) — unique per clinic deployment, never reused.
ENCRYPTION_KEY=

# WhatsApp provider (e.g. Fonnte) — platform-level API base; per-clinic device tokens
# are stored encrypted in the database, not here.
WHATSAPP_PROVIDER_API_BASE=

# Cron / scheduled jobs
REMINDER_CRON_SCHEDULE=
